#Resumen descriptivo
library(skimr)
# Convertir columnas de texto con separador de miles a numéricas
datos <- Telefonia_fija %>%
mutate(
Hogares   = as.numeric(gsub("\\.", "", Hogares)),
Comercial = as.numeric(gsub("\\.", "", Comercial)),
Gobierno = as.numeric(gsub("\\.", "", Gobierno)),
Otros = as.numeric(gsub("\\.", "", Otros)),
Total     = as.numeric(gsub("\\.", "", Total))
)
skim(datos)
#| warning: false
#Resumen descriptivo 2
library(dplyr)
# Convertir todas las columnas Hogares:Total a numéricas
#datos <- datos %>%
#  mutate(across(Hogares:Total,
#                ~as.numeric(gsub("\\.", "", .))))
resumen <- datos %>%
summarise(across(Hogares:Total,
list(media = mean,
mediana = median,
min = min,
max = max),
na.rm = TRUE)) %>%
pivot_longer(everything(),
names_to = c("variable", "medida"),
names_sep = "_") %>%
pivot_wider(names_from = medida, values_from = value)
print(resumen)
# Periodos Minimos y Maximos.
datos[which.max(datos$Total), ]
datos[which.min(datos$Total), ]
# Grafico
ggplot(datos, aes(x = Año)) +
geom_line(aes(y = Hogares, color = "Hogares"), size = 1) +
geom_line(aes(y = Comercial, color = "Comercial"), size = 1) +
geom_line(aes(y = Gobierno, color = "Gobierno"), size = 1) +
geom_line(aes(y = Otros, color = "Otros"), size = 1) +
labs(title = "Evolución de líneas fijas por dependencia",
x = "Año",
y = "Cantidad de líneas",
color = "Dependencia") +
theme_minimal()
# Pasar a formato largo
datos_long <- datos %>%
pivot_longer(cols = c(Hogares, Comercial, Gobierno, Otros),
names_to = "Dependencia",
values_to = "Lineas")
# Gráfico facetado con color
ggplot(datos_long, aes(x = Año, y = Lineas, color = Dependencia)) +
geom_line(size = 1) +
facet_wrap(~Dependencia, scales = "free_y", ncol = 2) +
labs(title = "Evolución de líneas fijas por dependencia",
x = "Año", y = "Cantidad de líneas") +
theme_minimal()
library(scales)
# Pasar a formato largo
datos_long <- datos %>%
pivot_longer(cols = c(Hogares, Comercial, Gobierno, Otros),
names_to = "Dependencia",
values_to = "Lineas")
# Gráfico facetado con color y formato
ggplot(datos_long, aes(x = Año, y = Lineas, color = Dependencia)) +
geom_line(size = 1) +
facet_wrap(~Dependencia, scales = "free_y", ncol = 2) +
scale_y_continuous(labels = comma_format(big.mark = ".", decimal.mark = ",")) +
scale_color_brewer(palette = "Set1") +
labs(title = "Evolución de líneas fijas por dependencia",
x = "Año", y = "Cantidad de líneas") +
theme_minimal(base_size = 13) +
theme(legend.position = "none",
strip.text = element_text(face = "bold"))
# Pasar a formato largo
datos_long <- datos %>%
pivot_longer(cols = c(Hogares, Comercial, Gobierno, Otros),
names_to = "Dependencia",
values_to = "Lineas")
# Calcular primer y último valor por dependencia
extremos <- datos_long %>%
group_by(Dependencia) %>%
summarise(
x_ini = min(Año),
x_fin = max(Año),
y_ini = first(Lineas),
y_fin = last(Lineas),
.groups = "drop"
)
# Gráfico facetado con línea entre primer y último valor
ggplot(datos_long, aes(x = Año, y = Lineas, color = Dependencia)) +
geom_line(size = 1) +
geom_segment(data = extremos,
aes(x = x_ini, xend = x_fin,
y = y_ini, yend = y_fin,
color = Dependencia),
linetype = "dashed", size = 1.2,
inherit.aes = FALSE) +
facet_wrap
