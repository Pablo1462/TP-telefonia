library(readr)
library(tidyverse)
Telefonia_fija <- read_csv("Telefonía Fija Accesos Totales.csv",
col_types = cols(
Año       = col_double(),
Trimestre = col_double(),
Hogares   = col_character(),
Comercial = col_character(),
Gobierno  = col_character(),
Otros     = col_character(),
Total     = col_character()
))
head(Telefonia_fija)
#Resumen descriptivo
library(skimr)
# Convertir columnas de texto con separador de miles a numéricas
datos <- Telefonia_fija %>%
mutate(
Hogares   = as.numeric(gsub("\\.", "", Hogares)),
Comercial = as.numeric(gsub("\\.", "", Comercial)),
Gobierno = as.numeric(gsub("\\.", "", Gobierno)),
Otros = as.numeric(gsub("\\.", "", Total)),
Total     = as.numeric(gsub("\\.", "", Total))
)
skim(datos)
#| warning: false
#Resumen descriptivo 2
library(dplyr)
# Convertir todas las columnas Hogares:Total a numéricas
#datos <- datos %>%
#  mutate(across(Hogares:Total,
#                ~as.numeric(gsub("\\.", "", .))))
resumen <- datos %>%
summarise(across(Hogares:Total,
list(media = mean,
mediana = median,
min = min,
max = max),
na.rm = TRUE)) %>%
pivot_longer(everything(),
names_to = c("variable", "medida"),
names_sep = "_") %>%
pivot_wider(names_from = medida, values_from = value)
print(resumen)
