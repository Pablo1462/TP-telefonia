# Armar tabla clara
valores <- data.frame(
Dependencia = names(primeros),
Primero = as.numeric(primeros),
Ultimo  = as.numeric(ultimos)
)
valores
# Extraer primer y último valor de cada dependencia
primeros <- datos[1, c("Hogares","Comercial","Gobierno","Otros")]
ultimos  <- datos[nrow(datos), c("Hogares","Comercial","Gobierno","Otros")]
# Armar tabla clara
valores <- data.frame(
Dependencia = names(primeros),
Primero = as.numeric(primeros),
Ultimo  = as.numeric(ultimos)
)
valores
# Calcular variación porcentual
valores$Variacion <- (valores$Ultimo - valores$Primero) / valores$Primero * 100
# Formatear con dos decimales y signo %
valores$Variacion <- sprintf("%.2f%%", valores$Variacion)
valores
View(datos)
View(Telefonía_Fija_Accesos_Totales)
#Importar Datos
library(readr)
library(tidyverse)
Telefonía_Fija_Accesos_Totales <- read_csv("Telefonía Fija Accesos Totales.csv")
head(Telefonía_Fija_Accesos_Totales)
#Resumen descriptivo
library(skimr)
datos <- Telefonía_Fija_Accesos_Totales
skim(datos)
#Resumen descriptivo 2
library(dplyr)
# Convertir todas las columnas Hogares:Total a numéricas
#datos <- datos %>%
#  mutate(across(Hogares:Total,
#                ~as.numeric(gsub("\\.", "", .))))
resumen <- datos %>%
summarise(across(Hogares:Total,
list(media = mean,
mediana = median,
min = min,
max = max),
na.rm = TRUE)) %>%
pivot_longer(everything(),
names_to = c("variable", "medida"),
names_sep = "_") %>%
pivot_wider(names_from = medida, values_from = value)
